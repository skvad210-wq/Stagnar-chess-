<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chess Arena — шахматы против ботов</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<style>
:root{--bg:#101820;--panel:#1b2935;--text:#f2f5f7;--muted:#a9bac7;--light:#e8dfca;--dark:#77936e;--gold:#f0bd55}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at top,#263e50,#101820 68%);color:var(--text);font:16px system-ui,Arial;padding:20px;display:flex;justify-content:center}
.app{width:min(100%,1000px)}header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.brand{color:var(--gold);font-size:12px;font-weight:800;letter-spacing:.15em}h1{margin:2px 0;font-size:clamp(25px,5vw,37px)}.rating{background:#263847;padding:10px 14px;border-radius:12px;font-weight:800;white-space:nowrap}.rating small{display:block;color:var(--muted);font-size:11px;font-weight:500}
.layout{display:grid;grid-template-columns:minmax(280px, min(67vw,640px)) minmax(230px,1fr);gap:18px;align-items:start}.board{width:100%;aspect-ratio:1;display:grid;grid-template-columns:repeat(8,1fr);border:7px solid #344653;border-radius:10px;overflow:hidden;box-shadow:0 18px 45px #0006}
.sq{border:0;padding:0;position:relative;display:grid;place-items:center;cursor:pointer;font-family:"DejaVu Sans",serif;font-size:clamp(27px,6.5vw,60px);line-height:1}.light{background:var(--light)}.dark{background:var(--dark)}.sq.selected{box-shadow:inset 0 0 0 5px var(--gold)}.sq.last{background-image:linear-gradient(#f5d46b55,#f5d46b55)}.sq.legal:after{content:"";position:absolute;width:23%;height:23%;border-radius:50%;background:#1c2a2680}.sq.capture:after{content:"";position:absolute;inset:4px;border:4px solid #1c2a2680;border-radius:50%}.piece{font-family:Georgia,'Times New Roman',serif;font-size:.88em;font-weight:400;line-height:1}.piece.white{color:#fff;text-shadow:0 1px 1px #263238}.piece.black{color:#202a30;text-shadow:0 1px 0 #ffffff70}
.mark{position:absolute;right:2px;top:0;font:bold clamp(11px,2vw,17px) Arial;color:#17232a;background:#fff2a8;border-radius:5px;padding:0 3px;z-index:2}
.panel{background:var(--panel);border:1px solid #ffffff18;border-radius:14px;padding:17px;box-shadow:0 14px 35px #0003}.status{font-size:18px;font-weight:800}.sub{color:var(--muted);font-size:13px;line-height:1.5;margin:5px 0 14px}.botcard{background:#263847;border-radius:11px;padding:11px;margin-bottom:12px}.botname{font-weight:800}.elo{color:var(--gold);font-size:13px;margin-top:3px}
label{display:block;color:var(--muted);font-size:12px;margin:12px 0 5px}select,button{font:inherit;border-radius:9px;border:1px solid #ffffff25;padding:10px 11px;background:#263847;color:var(--text)}select{width:100%}button{cursor:pointer;font-weight:700}button:hover{filter:brightness(1.12)}.primary{background:var(--gold);color:#1a2329;border:0}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.actions button:first-child{grid-column:1/-1}.moves{border-top:1px solid #ffffff1b;margin-top:15px;padding-top:11px}.moves h3{font-size:14px;margin:0 0 7px}.move-list{max-height:180px;overflow:auto;color:var(--muted);font-size:13px;line-height:1.9}.legend{font-size:12px;color:var(--muted);line-height:1.8;margin-top:12px}.legend b{color:var(--gold)}.notice{font-size:11px;color:#91a5b4;margin-top:10px}.clock-low{color:#ff7777}
@media(max-width:700px){body{padding:12px}.layout{grid-template-columns:1fr}.panel{order:2}.board{border-width:5px}.panel{padding:14px}}
</style></head>
<body style="background:#171020;color:white">
<h1 style="color:#bb86fc">STAGNAR CHESS — ТЕСТ</h1>
<main class="app">
<header><div><div class="brand">♟ CHESS ARENA</div><h1>Шахматы против ботов</h1></div><div class="rating"><span id="rating">800</span> ELO<small>Твой рейтинг</small></div></header>
<div class="layout"><div id="board" class="board"></div><aside class="panel">
<div id="status" class="status">Твой ход</div><div id="detail" class="sub">Выбери фигуру, затем клетку для хода.</div>
<div class="botcard"><div class="botname" id="botname">Новичок</div><div class="elo" id="botelo">400 ELO</div></div>
<label for="bot">Выбери соперника</label><select id="bot">
<option value="400">Новичок · 400 ELO</option><option value="600">Любитель · 600 ELO</option><option value="800" selected>Игрок клуба · 800 ELO</option><option value="1000">Тактик · 1000 ELO</option><option value="1200">Опытный · 1200 ELO</option><option value="1400">Мастер · 1400 ELO</option><option value="1600">Эксперт · 1600 ELO</option><option value="1800">Гроссмейстер · 1800 ELO</option>
</select>
<label for="side">Цвет фигур</label><select id="side"><option value="w">Белые</option><option value="b">Чёрные</option><option value="random" selected>Случайный выбор</option></select>
<label for="time">Контроль времени</label><select id="time"><option value="0">Без времени</option><option value="60">1 минута (пуля)</option><option value="180" selected>3 минуты (блиц)</option><option value="300">5 минут</option><option value="600">10 минут</option></select>
<div class="botcard" style="display:flex;justify-content:space-between;gap:10px;margin-top:12px"><div><small style="color:var(--muted)">ТВОЁ ВРЕМЯ</small><div id="myclock" style="font-size:24px;font-weight:850">03:00</div></div><div style="text-align:right"><small style="color:var(--muted)">БОТ</small><div id="botclock" style="font-size:24px;font-weight:850">03:00</div></div></div>
<div class="actions"><button class="primary" id="new">Новая партия</button><button id="undo">Отменить ход</button><button id="flip">Перевернуть доску</button></div>
<div class="moves"><h3>История ходов</h3><div id="moves" class="move-list">Пока ходов нет.</div></div>
<div class="legend"><b>!!</b> Бриллиантовый ход · <b>!</b> Отличный ход<br><b>?!</b> Сомнительный ход · <b>?</b> Ошибка · <b>??</b> Грубая ошибка</div>
<div class="notice">Оценки ходов и сила ботов приблизительные, это учебный игровой движок, а не официальный рейтинг FIDE.</div>
</aside></div></main>
<script>
window.onerror = function(message, source, line) {
  document.body.innerHTML =
    '<div style="background:#171020;color:white;padding:25px;font:18px Arial">' +
    '<h2>ОШИБКА STAGNAR CHESS</h2>' +
    '<p>' + message + '</p><p>Строка: ' + line + '</p></div>';
};
(()=> {
 const game=new Chess(),board=document.getElementById('board'),$=id=>document.getElementById(id);
 const glyph={wk:'♔',wq:'♕',wr:'♖',wb:'♗',wn:'♘',wp:'♙',bk:'♚',bq:'♛',br:'♜',bb:'♝',bn:'♞',bp:'♟'};
 const botNames={400:'Новичок',600:'Любитель',800:'Игрок клуба',1000:'Тактик',1200:'Опытный',1400:'Мастер',1600:'Эксперт',1800:'Гроссмейстер'};
 const vals={p:100,n:320,b:330,r:500,q:900,k:20000};
 let human='w',selected=null,legal=[],flipped=false,thinking=false,lastMove=null,marks={},rated=false,clockBase=180,clocks={w:180,b:180},clockTimer=null,lastTick=0;
 let rating=Number(localStorage.getItem('chessArenaRating')||800);
 $('rating').textContent=rating;
 function pos(){return game.board()}
 function evalBoard(){let s=0,b=pos();for(let r=0;r<8;r++)for(let c=0;c<8;c++){let p=b[r][c];if(p){let v=vals[p.type];if(p.type==='p')v+=(p.color==='w'?6-r:r-1)*5;s+=p.color==='w'?v:-v;}}return s;}
 function search(depth,alpha,beta,max){if(depth<=0||game.game_over())return evalBoard();let ms=game.moves({verbose:true});if(max){let best=-Infinity;for(let m of ms){game.move(m);best=Math.max(best,search(depth-1,alpha,beta,false));game.undo();alpha=Math.max(alpha,best);if(beta<=alpha)break;}return best;}let best=Infinity;for(let m of ms){game.move(m);best=Math.min(best,search(depth-1,alpha,beta,true));game.undo();beta=Math.min(beta,best);if(beta<=alpha)break;}return best;}
 function bestScoreFor(color,depth){let ms=game.moves({verbose:true}),best=color==='w'?-Infinity:Infinity;for(let m of ms){game.move(m);let v=search(depth-1,-Infinity,Infinity,game.turn()==='w');game.undo();best=color==='w'?Math.max(best,v):Math.min(best,v);}return best;}
 function annotate(before,after,best,move,color){let loss=color==='w'?best-after:after-best;let capture=move.captured; if(loss<12&&capture)return '!!';if(loss<12)return '!';if(loss<35)return '';if(loss<85)return '?!';if(loss<180)return '?';return '??';}
 function render(){board.innerHTML='';let b=pos();for(let vr=0;vr<8;vr++)for(let vc=0;vc<8;vc++){let r=flipped?7-vr:vr,c=flipped?7-vc:vc,sq='abcdefgh'[c]+(8-r),p=b[r][c],el=document.createElement('button');el.className='sq '+((r+c)%2?'dark':'light');if(selected===sq)el.classList.add('selected');if(lastMove&&(lastMove.from===sq||lastMove.to===sq))el.classList.add('last');let lm=legal.find(m=>m.to===sq);if(lm)el.classList.add(game.get(sq)?'capture':'legal');if(p){let sp=document.createElement('span');sp.className='piece '+(p.color==='w'?'white':'black');sp.textContent=glyph[p.color+p.type];el.appendChild(sp);}if(marks[sq]){let badge=document.createElement('span');badge.className='mark';badge.textContent=marks[sq];el.appendChild(badge);}el.addEventListener('click',()=>click(sq));board.appendChild(el);}
 update();}
 function update(){let title='Твой ход',detail=game.turn()===human?'Выбери фигуру и клетку назначения.':'Бот выбирает ход…';if(game.in_checkmate()){title='Мат!';detail=game.turn()===human?'Ты проиграл партию.':'Ты победил!';finish(game.turn()!==human?'win':'loss');}else if(game.in_draw()){title='Ничья';detail='Партия завершилась вничью.';finish('draw');}else if(game.in_check()){title='Шах!';detail='Королю угрожают.';}else if(game.turn()!==human){title='Ход бота';} $('status').textContent=title;$('detail').textContent=detail;let h=game.history({verbose:true}),rows=[];h.forEach((m,i)=>{let san=m.san+(marks[m.to]||'');if(i%2===0)rows.push((Math.floor(i/2)+1)+'. '+san);else rows[rows.length-1]+='  '+san;});$('moves').textContent=rows.join(' | ')||'Пока ходов нет.';}
 function click(sq){if(thinking||game.game_over()||game.turn()!==human)return;let p=game.get(sq);if(selected&&legal.some(m=>m.to===sq)){makeMove(selected,sq,true);return;}if(p&&p.color===human){selected=sq;legal=game.moves({square:sq,verbose:true});}else{selected=null;legal=[];}render();}
 function makeMove(from,to,isHuman){let color=game.turn(),depth=Number($('bot').value)>=1600?2:1;let best=bestScoreFor(color,depth);let move=game.move({from,to,promotion:'q'});if(!move)return;let after=evalBoard(),mark=annotate(best,after,best,move,color); // refined against best score before move
   let loss=color==='w'?best-after:after-best;
   mark=loss<8?(move.captured?'!!':'!'):loss<25?'':loss<65?'?!':loss<150?'?':'??';
   marks[to]=mark;lastMove=move;selected=null;legal=[];lastTick=Date.now();drawClocks();render();if(!game.game_over()&&isHuman)setTimeout(botMove,160);}
 function botMove(){if(game.game_over()||game.turn()===human)return;thinking=true;render();let elo=Number($('bot').value),depth=elo<=600?1:elo<=1200?2:3;let ms=game.moves({verbose:true}),color=game.turn(),ranked=[];for(let m of ms){game.move(m);let v=search(depth-1,-Infinity,Infinity,game.turn()==='w');game.undo();ranked.push({m,v});}ranked.sort((a,b)=>color==='w'?b.v-a.v:a.v-b.v);let top=ranked.slice(0,Math.max(1,Math.ceil(ranked.length*(elo<=600?.65:elo<=1000?.35:.12))));let chosen=top[Math.floor(Math.random()*top.length)].m;let mv=game.move({from:chosen.from,to:chosen.to,promotion:'q'});lastMove=mv;marks[chosen.to]='';thinking=false;lastTick=Date.now();drawClocks();render();}
 function fmt(t){t=Math.max(0,Math.ceil(t));return String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');}
 function drawClocks(){let mine=clocks[human],theirs=clocks[human==='w'?'b':'w'];$('myclock').textContent=fmt(mine);$('botclock').textContent=fmt(theirs);$('myclock').classList.toggle('clock-low',mine<=10&&clockBase>0);$('botclock').classList.toggle('clock-low',theirs<=10&&clockBase>0);}
 function stopClock(){if(clockTimer){clearInterval(clockTimer);clockTimer=null;}}
 function tick(){if(!clockBase||game.game_over()||thinking)return;let now=Date.now(),elapsed=(now-lastTick)/1000;lastTick=now;let side=game.turn();clocks[side]=Math.max(0,clocks[side]-elapsed);drawClocks();if(clocks[side]<=0){stopClock();thinking=false;finish(side===human?'loss':'win');$('status').textContent='Время вышло!';$('detail').textContent=side===human?'Ты проиграл по времени.':'Бот проиграл по времени.';}}
 function runClock(){stopClock();lastTick=Date.now();if(clockBase>0)clockTimer=setInterval(tick,200);drawClocks();}
 function finish(result){if(rated)return;rated=true;stopClock();let elo=Number($('bot').value),change=result==='win'?Math.max(8,Math.round((elo-rating)/100)+16):result==='loss'?-Math.max(6,Math.round((rating-elo)/100)+14):0;rating=Math.max(100,rating+change);localStorage.setItem('chessArenaRating',rating);$('rating').textContent=rating;if(change)$('detail').textContent+=(change>0?' Рейтинг +':' Рейтинг ')+change+' ELO.';}
 function start(){stopClock();game.reset();let sideChoice=$('side').value;human=sideChoice==='random'?(Math.random()<.5?'w':'b'):sideChoice;flipped=human==='b';selected=null;legal=[];lastMove=null;marks={};thinking=false;rated=false;clockBase=Number($('time').value);clocks={w:clockBase,b:clockBase};let e=$('bot').value;$('botname').textContent=botNames[e];$('botelo').textContent=e+' ELO';drawClocks();render();runClock();if(human==='b')setTimeout(botMove,250);}
 $('new').onclick=start;$('undo').onclick=()=>{if(thinking)return;game.undo();if(game.turn()!==human)game.undo();selected=null;legal=[];lastMove=null;marks={};rated=false;lastTick=Date.now();drawClocks();render();};$('flip').onclick=()=>{flipped=!flipped;render();};$('bot').onchange=start;$('side').onchange=start;$('time').onchange=start;start();
})();
</script></body></html>
